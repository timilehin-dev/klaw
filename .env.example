# Slack (single-workspace dev token still works as fallback)
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret

# Slack OAuth (multi-tenant install)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Encrypt workspace bot tokens at rest (openssl rand -hex 32)
ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Fallback Slack channel for cron tasks without slack_channel set
DEFAULT_SLACK_CHANNEL=C0123456789

# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (browser — dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Upstash
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Tavily
TAVILY_API_KEY=tvly-your-tavily-key

# Modal
MODAL_KEY=wk-your-modal-key
MODAL_SECRET=ws-your-modal-secret

# Modal LLM Endpoints (OpenAI-compatible)
KIMI_K3_URL=https://timilehinolajide32--ep-kimi-k3-server.us-west.modal.direct
DEEPSEEK_V4_URL=https://your-deepseek-v4-url.modal.direct

# Modal Sandbox Execution URL (manual deploy: modal deploy modal/sandboxes/execute_code.py)
# 32GB RAM sandbox — paste the execute_code endpoint URL Modal prints
MODAL_EXECUTE_URL=https://your-workspace--klaw-sandbox-execute-code.modal.run

# Modal Browser Automation (manual deploy: modal deploy modal/sandboxes/browser_automation.py)
MODAL_BROWSER_URL=https://your-workspace--klaw-browser-browser-action.modal.run
